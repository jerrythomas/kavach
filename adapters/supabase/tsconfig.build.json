{
  "extends": "../../config/tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationDir": "./dist",
    "emitDeclarationOnly": false,
    "outDir": "./dist",
    "allowJs": true,
    "rootDir": "src",
    "allowImportingTsExtensions": false
  },
  "include": ["src/**/*"],
  "exclude": ["**/spec/**/*", "**/fixtures/**/*", "node_modules", "dist"]
}
