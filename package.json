{
  "name": "kavach-workspace",
  "version": "1.1.3",
  "description": "Drop in security for SvelteKit Apps.",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.10",
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "prepare": "husky",
    "clean": "find . -name node_modules -type d -prune -exec rm -rf '{}' +",
    "test:watch": "NODE_NO_WARNINGS=1 vitest --config config/vitest.config.js",
    "test:ci": "NODE_NO_WARNINGS=1 vitest run --config config/vitest.config.js",
    "coverage": "NODE_NO_WARNINGS=1 vitest run --coverage --config config/vitest.config.js",
    "format": "prettier --config config/.prettierrc --ignore-path config/.prettierignore --write .",
    "lint": "eslint --config config/eslint.config.mjs --fix",
    "lockfile": "bun install",
    "sync:manifest": "node scripts/sync-library-manifest.mjs",
    "build:all": "bash scripts/build-all.sh",
    "upgrade:all": "bun update --latest",
    "bump": "bumpp --configFilePath config/bump.config.js",
    "bump:next": "bumpp --configFilePath config/bump.config.js --preid=next",
    "publish:packages": "find ./packages -type d -depth 1 -exec sh -c 'cd \"{}\" && bun publish' \\;",
    "publish:adapters": "find ./adapters -type d -depth 1 -exec sh -c 'cd \"{}\" && bun publish' \\;",
    "publish:all": "bun run publish:packages && bun run publish:adapters",
    "release": "bun run publish:all",
    "e2e:supabase": "bash scripts/e2e-supabase.sh test",
    "e2e:supabase:start": "bash scripts/e2e-supabase.sh start",
    "e2e:supabase:stop": "bash scripts/e2e-supabase.sh stop",
    "e2e:firebase": "bash scripts/e2e-firebase.sh test",
    "e2e:firebase:start": "bash scripts/e2e-firebase.sh start",
    "e2e:firebase:stop": "bash scripts/e2e-firebase.sh stop",
    "e2e:convex": "bash scripts/e2e-convex.sh test",
    "e2e:convex:start": "bash scripts/e2e-convex.sh start",
    "e2e:convex:stop": "bash scripts/e2e-convex.sh stop"
  },
  "author": "Jerry Thomas<me@jerrythomas.name",
  "license": "MIT",
  "devDependencies": {
    "@jerrythomas/prettier-config": "^1.0.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/ramda": "^0.32.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/coverage-v8": "^5.0.0",
    "bumpp": "^12.3.0",
    "eslint": "^10.10.0",
    "eslint-plugin-svelte": "^3.23.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.57.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "lint-staged": {
    "*.{js,svelte}": "eslint --config config/eslint.config.mjs --cache --fix",
    "*.{js,svelte,md,json}": "prettier --config config/.prettierrc --write"
  },
  "workspaces": [
    "adapters/*",
    "packages/**",
    "sites/**"
  ],
  "dependencies": {
    "@fontsource/open-sans": "^5.3.0",
    "@fontsource/overpass": "^5.3.0",
    "@fontsource/victor-mono": "^5.3.0",
    "@rokkit/actions": "1.4.1",
    "@rokkit/core": "1.4.1",
    "@rokkit/data": "1.4.1",
    "@rokkit/forms": "1.4.1",
    "@rokkit/icons": "1.4.1",
    "@rokkit/states": "1.4.1",
    "@rokkit/themes": "1.4.1",
    "@rokkit/ui": "1.4.1"
  }
}
