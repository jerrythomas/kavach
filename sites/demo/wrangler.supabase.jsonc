{
	// Per-adapter demo deploy config (Workers Static Assets). Mirrors
	// sites/learn/wrangler.jsonc: build with WORKERS_CI (or run the committed
	// deploy script) so @sveltejs/adapter-cloudflare emits
	// .svelte-kit/cloudflare/ (_worker.js + .assetsignore), then:
	//
	//   bunx wrangler deploy -c wrangler.supabase.jsonc
	//
	// `name` must match the Cloudflare Worker project name. Bind the custom
	// domain with:
	//
	//   bunx wrangler domains add kavach-supabase supabase.kavach.sensei-hq.com
	//
	// PUBLIC_* vars in `vars` are runtime values for $env/dynamic/public; the
	// build-time env (KAVACH_ADAPTER, PUBLIC_SUPABASE_URL, PUBLIC_SUPABASE_ANON_KEY)
	// is provided by sites/showcase/deploy-demo.sh from .env.supabase.
	"name": "kavach-supabase",
	"compatibility_date": "2026-06-13",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"preview_urls": true,
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"vars": {
		"PUBLIC_KAVACH_ADAPTER": "supabase"
	},
	"observability": { "enabled": true }
}
