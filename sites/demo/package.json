{
  "name": "demo-kavach",
  "version": "1.2.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build:deps": "bun run --cwd ../.. build:all",
    "predev": "npm run build:deps",
    "dev": "vite dev",
    "prebuild": "npm run build:deps",
    "build": "vite build",
    "preview": "vite preview",
    "check": "bun node_modules/@kavach/vite/scripts/generate-dts.mjs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "emulators": "bunx firebase emulators:start",
    "convex:dev": "bunx convex dev --local"
  },
  "devDependencies": {
    "@kavach/vite": "workspace:*",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/kit": "^2.54.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@unocss/extractor-svelte": "66.10.0",
    "@unocss/reset": "66.10.0",
    "@unocss/vite": "66.10.0",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.15.2",
    "firebase-tools": "^15.10.0",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.53.10",
    "svelte-check": "^4.4.5",
    "typescript": "^5.9.3",
    "unocss": "66.10.0",
    "vite": "^7.3.1",
    "wrangler": "^4.100.0"
  },
  "type": "module",
  "dependencies": {
    "@convex-dev/auth": "^0.0.95",
    "@kavach/adapter-convex": "workspace:*",
    "@kavach/adapter-firebase": "workspace:*",
    "@kavach/adapter-supabase": "workspace:*",
    "@kavach/logger": "workspace:*",
    "@kavach/ui": "workspace:*",
    "@rokkit/actions": "1.4.1",
    "@rokkit/app": "1.4.1",
    "@rokkit/core": "1.4.1",
    "@rokkit/icons": "1.4.1",
    "@rokkit/states": "1.4.1",
    "@rokkit/themes": "1.4.1",
    "@rokkit/ui": "1.4.1",
    "@rokkit/unocss": "1.4.1",
    "@supabase/supabase-js": "^2.99.1",
    "convex": "^1.24.0",
    "firebase": "^12.0.0",
    "kavach": "workspace:*",
    "showcase-kavach": "workspace:*"
  }
}
